# Copy this file to .env and fill in your own free keys.

# Server
PORT=5000

# MongoDB Atlas connection string (free M0 cluster)
# Get this from Atlas -> Database -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/visory?retryWrites=true&w=majority

# Gemini API key (free) - from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use. gemini-2.5-flash is free-tier and stable.
# (Google is retiring 2.5 models on 16 Oct 2026 - if that's already passed
# for you, switch this to gemini-3.1-flash-lite, no code changes needed.)
GEMINI_MODEL=gemini-2.5-flash

# YouTube Data API v3 key (free quota) - from Google Cloud Console
# Can be the SAME Google Cloud project as Gemini, just enable
# "YouTube Data API v3" for it and create a key.
YOUTUBE_API_KEY=your_youtube_api_key_here

# Allowed frontend origin for CORS
CLIENT_ORIGIN=http://localhost:5173
